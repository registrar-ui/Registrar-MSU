generator client {
  provider = "prisma-client-js"
}

datasource db {
  // SQLite for local dev — zero setup, just a file on disk.
  // To move to Postgres later: change provider to "postgresql" and
  // set DATABASE_URL to your Postgres connection string. No other
  // code in the app needs to change.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
}

model Announcement {
  id          String   @id @default(cuid())
  date        DateTime
  category    String
  title       String
  description String
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Category {
  id   String @id @default(cuid())
  name String @unique
}